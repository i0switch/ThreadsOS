{
  "name": "threads-note-os",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "lint": "biome check .",
    "contracts:compile": "tsx src/cli/contracts-compile.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "job:tier:15m": "tsx src/jobs/tier-15m.ts",
    "job:tier:15m:dry": "tsx src/jobs/tier-15m.ts --dry-run",
    "job:tier:1h": "tsx src/jobs/tier-1h.ts",
    "job:tier:1h:dry": "tsx src/jobs/tier-1h.ts --dry-run",
    "job:tier:1d": "tsx src/jobs/tier-1d.ts",
    "job:tier:1d:dry": "tsx src/jobs/tier-1d.ts --dry-run",
    "job:tier:1w": "tsx src/jobs/tier-1w.ts",
    "job:tier:1w:dry": "tsx src/jobs/tier-1w.ts --dry-run",
    "job:heartbeat": "tsx src/jobs/hourly-heartbeat.ts",
    "job:heartbeat:dry": "tsx src/jobs/hourly-heartbeat.ts --dry-run",
    "job:heartbeat:loop": "tsx src/jobs/heartbeat-loop.ts",
    "job:heartbeat:loop:dry": "tsx src/jobs/heartbeat-loop.ts --dry-run",
    "job:daily-topic-research": "tsx src/jobs/daily-topic-research.ts",
    "job:daily-threads-plan": "tsx src/jobs/daily-threads-plan.ts",
    "job:post-publish-followup": "tsx src/jobs/post-publish-followup.ts",
    "job:metrics-sync": "tsx src/jobs/metrics-sync.ts",
    "job:nightly-note-pipeline": "tsx src/jobs/nightly-note-pipeline.ts",
    "job:weekly-retro": "tsx src/jobs/weekly-retro.ts",
    "input:research": "tsx src/cli/input.ts research",
    "input:feedback": "tsx src/cli/input.ts feedback",
    "input:directive": "tsx src/cli/input.ts directive",
    "setup": "tsx src/cli/setup.ts",
    "note:login": "tsx src/cli/note-login.ts",
    "job:llm-worker": "tsx src/jobs/llm-heartbeat-worker.ts",
    "job:refresh-token": "tsx src/jobs/refresh-threads-token.ts",
    "job:refresh-token:dry": "tsx src/jobs/refresh-threads-token.ts --dry-run",
    "start:daemon": "pm2 start ecosystem.config.cjs && pm2 save",
    "stop:daemon": "pm2 stop threadsos-15m threadsos-1h threadsos-1d threadsos-1w llm-worker",
    "logs": "pm2 logs"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.50.0",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
